{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Open Autoclicker",
  "version": "0.3.2",
  "identifier": "com.jasperdevs.open-autoclicker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Open Autoclicker",
        "label": "main",
        "width": 460,
        "height": 600,
        "minWidth": 440,
        "minHeight": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jasperdevs/open-autoclicker/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign-windows.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}
