{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Open Autoclicker",
  "version": "0.1.0",
  "identifier": "com.jasperdevs.open-autoclicker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Open Autoclicker",
        "label": "main",
        "width": 460,
        "height": 580,
        "minWidth": 440,
        "minHeight": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
